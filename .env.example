APP_RELEASE_STORE_PASSWORD=
APP_RELEASE_KEY_PASSWORD=

FIREBASE_FUNCTIONS_URL=

# Debug tokens (only for local development)
APPCHECK_DEBUG_TOKEN_ANDROID=
APPCHECK_DEBUG_TOKEN_IOS=

# NovaHub/Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
NOVAHUB_API_BASE_URL=https://novahub.ai

# App Configuration
APP_URL=novamind://app

# Feature Flags (true/false)
ENABLE_NOVAHUB_INTEGRATION=true
ENABLE_AUTHENTICATION=true
ENABLE_OFFLINE_MODE=true

# Google Sign-In Configuration
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# AgentRouter cloud AI endpoint (OpenAI-compatible). When both values are set,
# the app seeds it as a built-in remote server. Leave empty to hide it.
AGENTROUTER_BASE_URL=https://agentrouter-5c61ba90b667.herokuapp.com/v1
AGENTROUTER_API_KEY=
